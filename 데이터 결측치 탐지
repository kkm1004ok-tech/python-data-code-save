## 결측치 시각화: seaborn
import seaborn as sns
import matplotlib.pyplot as plt

  ##version 1
plt.figure(figsize=(12,6))
sns.heatmap(df.isnull(),cbar=False,cmap='viridis')
plt.xlabel('variables')
plt.ylabel('Data Index')
plt.title('Heatmap of Missing Data')
