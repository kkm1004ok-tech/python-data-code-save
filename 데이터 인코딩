import pandas as pd

##csv 데이터 불러오기
url="https://openmv.net/file/travel-times.csv"
df=pd.read_csv(url)

##레이블 인코딩
from sklearn.preprocessing import LabelEncoder
encoder_label=LabelEncoder()
df['DayOfWeek_label']=encoder_label.fit_transform(df['DayOfWeek'])
print(df['DayOfWeek_label'].head())

## 순서가 있는 범주형데이터도 사용
## 순서가 보존되지 않음.
## 원본데이터에 없던 우열관계가 생성됨...


##순서형인코딩
from sklearn.preprocessing import OrdinalEncoder
enc=OrdinalEncoder(categories=[['Monday','Tuesday','Wednesday','Thursday','Friday']])
df['DayOfWeek_ordinal']=enc.fit_transform(df[['DayOfWeek']])
print(df['DayOfWeek_ordinal'].head())

## 원핫인코딩
## 오직하나만 1이 되도록, 범주마자 가짜 이진변수를 만들어 표시하며, 
## 인코딩된 숫자에 의한 크기의미가 부여되지 않음
## 딥러닝,선형모델, 신경망 등에 잘 어울림
## 다중공선성 문제 발생... 

